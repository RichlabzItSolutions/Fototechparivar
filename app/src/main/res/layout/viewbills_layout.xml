<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/boder"
    android:padding="16dp"
    android:layout_marginTop="10dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/name"
                android:textColor="?attr/colorPrimaryDark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:id="@+id/nameBill"
                android:text="Nikiunj Kanani"
                android:textSize="14sp"
                android:textColor="#0E151F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/store_bill_number"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/storeNumberBillTxt"
                android:layout_marginTop="5dp"
                android:text="FT03184"
                android:textSize="14sp"
                android:textColor="#0E151F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sales_details"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/salesDetailsbillTxt"
                android:layout_marginTop="5dp"
                android:text="Photo Book"
                android:textSize="14sp"
                android:textColor="#0E151F" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/parivar_card_details"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:id="@+id/membershipDetailbillText"
                android:text="000107"
                android:textSize="14sp"
                android:textColor="#0E151F" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/coupon_code"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/couponCodeBillTxt"
                android:layout_marginTop="5dp"
                android:text="MUVA027"
                android:textSize="14sp"
                android:textColor="#0E151F" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/amount"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/amountBillTxt"
                android:layout_marginTop="5dp"
                android:text="Rs. 7,350.00"
                android:textSize="14sp"
                android:textColor="#0E151F" />

        </LinearLayout>


    </LinearLayout>

